<?xml version="1.0" encoding="utf-8"?>
<!--
  A stand-in for WhatsApp on the emulator.

  The real app cannot run here: this AVD is a google_apis image (no Play Store)
  on x86_64, and WhatsApp ships ARM-only native libraries. What matters for
  Little Loaf is only that the Click-to-Chat link is built correctly and that
  something claims it, so this app registers the same intent filters WhatsApp
  does and prints whatever it is handed.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="WhatsApp (stub)"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="WhatsApp (stub)">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Click-to-Chat, which is what Little Loaf actually launches.

              autoVerify lets this be approved as the wa.me handler with
              `pm set-app-links`. Without it Chrome wins the link, because on a
              real phone WhatsApp owns the domain and this stub cannot.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="wa.me" />
                <data android:scheme="http" android:host="wa.me" />
                <data android:scheme="https" android:host="api.whatsapp.com" />
                <data android:scheme="https" android:host="chat.whatsapp.com" />
            </intent-filter>

            <!-- the app-scheme form, for completeness -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="whatsapp" />
            </intent-filter>

            <!-- share-sheet text, the other way a message can arrive -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
